{
  "name": "cv-ssh",
  "version": "1.0.0",
  "description": "My CV as an SSH-served terminal app",
  "scripts": {
    "dev": "tsx watch src/index.ts | pino-pretty",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "LOG_LEVEL=silent node --import tsx --test \"src/**/*.test.ts\""
  },
  "author": "",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "dependencies": {
    "figlet": "^1.12.0",
    "ink": "^8.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "ssh2": "^1.17.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
